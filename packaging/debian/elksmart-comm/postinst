#!/bin/sh
set -e
# apply the udev rule now, so a dongle that is already plugged in works
if [ "$1" = configure ] && command -v udevadm >/dev/null 2>&1; then
	udevadm control --reload 2>/dev/null || true
	udevadm trigger --action=add --subsystem-match=usb --attr-match=idVendor=045c 2>/dev/null || true
fi
#DEBHELPER#
exit 0
